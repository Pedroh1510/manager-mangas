# Supply-chain hardening — manager-mangas
# Requer npm >= 11 (min-release-age). Ver "engines" em package.json.

# Só resolve versão publicada há mais de 7 dias.
# Reduz exposição a pacote malicioso recém-publicado (supply chain attack).
min-release-age=7

# Bloqueia todo lifecycle script (preinstall/install/postinstall) de QUALQUER dependência,
# incluindo scripts do próprio projeto disparados no install.
# Pacotes que precisam de script ficam na allowlist manual — rodar `npm run rebuild:approved`
# depois do install/ci. Ver script no package.json.
ignore-scripts=true

# Threshold do `npm audit` (usado no CI) — só sai com exit code != 0 em high/critical.
audit-level=high

# Trava registry explícito.
registry=https://registry.npmjs.org/

# Falha o install se a versão do npm não atender "engines" do package.json —
# sem isso, min-release-age vira no-op silencioso em npm < 11.
engine-strict=true
